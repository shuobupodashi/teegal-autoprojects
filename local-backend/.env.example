# ECS 常驻后端环境变量模板（复制为 .env 后按需修改）

# 服务端口
PORT=3001

# WebSocket 配置
WS_PATH=/ws
WS_HEARTBEAT_INTERVAL=30000

# 日志级别
LOG_LEVEL=info

# 🔥 云端 GPU 执行层（hosted）：本地零渠道概念
# GPU 规格/价格/库存/云厂商凭证全部在云端服务维护，本地仅持服务间密钥
GPU_WORKER_SECRET=your-worker-secret

# 云端地址（OSS 直传签名、GPU 代理均走此地址；不配置则默认官方服务 https://www.workbees.space）
# HOME_WEB_URL=https://your-cloud-service
